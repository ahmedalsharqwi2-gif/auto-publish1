# Copy to .env.local and fill in secrets locally; never commit secret values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_RETRIES=3

BUFFER_API_KEY=
# Comma-separated Buffer channel IDs (not platform names).
BUFFER_CHANNEL_IDS=
# addToQueue is recommended; shareNow publishes immediately.
BUFFER_POST_MODE=addToQueue

TTS_ENGINE=edge
EDGE_TTS_VOICE=ar-SA-HamedNeural
EDGE_TTS_RATE=+10%

# GitHub Actions provides GITHUB_TOKEN and GITHUB_REPOSITORY automatically.
# For local release hosting, set a token with contents:write on this public repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ahmedalsharqwi2-gif/auto-publish1

MIN_WORDS=90
MAX_WORDS=165
MAX_REEL_SECONDS=90
MIN_QUALITY_SCORE=0.75
OUTPUT_DIR=output
CATEGORY=عام
LOG_LEVEL=INFO
